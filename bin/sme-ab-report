#!/usr/bin/env python3
"""
sme-ab-report — Aggregate runs.jsonl into an A/B comparison by task_type.

Reads the runs ledger and joins to scores.jsonl (latest score per run_id).
Groups by (task_type, sme_mode), computes aggregates per-mode, and prints
side-by-side comparison plus paired-only stats and a classifier audit.

Usage:
    sme-ab-report [--since N] [--task-type T] [--in PATH] [--scores PATH]
                  [--paired-only] [--classifier-audit]

    --since N            restrict to runs in the last N days
    --task-type T        restrict to a single task_type
    --in PATH            runs.jsonl path (default: ~/.claude-pipeline/ab-runs/runs.jsonl)
    --scores PATH        scores.jsonl path (default: ~/.claude-pipeline/ab-runs/scores.jsonl)
    --paired-only        show only paired-run comparison (skip per-task aggregate)
    --classifier-audit   show task_type_source breakdown
"""
from __future__ import annotations

import argparse
import json
import statistics as stats
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any


def parse_runs(path: Path, since_days: int | None, task_filter: str | None) -> list[dict[str, Any]]:
    if not path.is_file():
        return []
    rows: list[dict[str, Any]] = []
    cutoff = None
    if since_days is not None:
        cutoff = datetime.now(timezone.utc) - timedelta(days=since_days)
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if task_filter and row.get("task_type") != task_filter:
            continue
        if cutoff is not None:
            ts = row.get("started_at") or ""
            try:
                row_dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
                if row_dt < cutoff:
                    continue
            except (ValueError, TypeError):
                continue
        rows.append(row)
    return rows


def safe_mean(xs: list[float]) -> float | None:
    return stats.fmean(xs) if xs else None


def safe_median(xs: list[float]) -> float | None:
    return stats.median(xs) if xs else None


def fmt(v: float | int | None, suffix: str = "") -> str:
    if v is None:
        return "-"
    if isinstance(v, float):
        return f"{v:.1f}{suffix}"
    return f"{v}{suffix}"


def aggregate(rows: list[dict[str, Any]]) -> dict[str, Any]:
    if not rows:
        return {
            "count": 0, "success_rate": None, "duration_mean": None,
            "duration_median": None, "diff_added_mean": None,
            "diff_removed_mean": None, "phases_mean": None,
            "preamble_chars_mean": None, "score_mean": None,
        }
    successes = sum(1 for r in rows if r.get("outcome") == "success")
    durations = [float(r.get("duration_seconds") or 0) for r in rows]
    diffs_a = [float(r.get("git_diff_added") or 0) for r in rows]
    diffs_r = [float(r.get("git_diff_removed") or 0) for r in rows]
    phases = [float(r.get("phases_completed") or 0) for r in rows]
    preamble = [float(r.get("preamble_size_chars") or 0) for r in rows]
    scores = [float(r["__score__"]) for r in rows if r.get("__score__") is not None]
    return {
        "count": len(rows),
        "success_rate": successes / len(rows),
        "duration_mean": safe_mean(durations),
        "duration_median": safe_median(durations),
        "diff_added_mean": safe_mean(diffs_a),
        "diff_removed_mean": safe_mean(diffs_r),
        "phases_mean": safe_mean(phases),
        "preamble_chars_mean": safe_mean(preamble),
        "score_mean": safe_mean(scores),
        "scored_count": len(scores),
    }


def load_latest_scores(path: Path) -> dict[str, int]:
    """Read scores.jsonl, return {run_id: latest_score} (by scored_at)."""
    if not path.is_file():
        return {}
    by_run: dict[str, tuple[str, int]] = {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        rid = row.get("run_id")
        score = row.get("score")
        ts = row.get("scored_at") or ""
        if rid is None or not isinstance(score, (int, float)):
            continue
        prev = by_run.get(rid)
        if prev is None or ts > prev[0]:
            by_run[rid] = (ts, int(score))
    return {rid: s for rid, (_, s) in by_run.items()}


def delta_pct(on_v: float | None, off_v: float | None) -> str:
    if on_v is None or off_v is None or off_v == 0:
        return "-"
    pct = (on_v - off_v) / off_v * 100
    sign = "+" if pct > 0 else ""
    return f"{sign}{pct:.1f}%"


def render_task_section(task_type: str, on: dict[str, Any], off: dict[str, Any]) -> str:
    lines: list[str] = []
    lines.append(f"\n## task_type: {task_type}")
    lines.append("")
    lines.append(f"  Runs: SME-on={on['count']}  SME-off={off['count']}")
    if on["count"] == 0 or off["count"] == 0:
        lines.append("  (need ≥1 run in each mode for comparison)")
        return "\n".join(lines)

    rows: list[tuple[str, str, str, str]] = [
        ("metric", "SME-on", "SME-off", "Δ%"),
    ]
    metrics: list[tuple[str, str, str]] = [
        ("success rate",     "success_rate",        "%"),
        ("duration mean",    "duration_mean",       "s"),
        ("duration median",  "duration_median",     "s"),
        ("phases completed", "phases_mean",         ""),
        ("diff added",       "diff_added_mean",     ""),
        ("diff removed",     "diff_removed_mean",   ""),
        ("preamble chars",   "preamble_chars_mean", ""),
        ("review_score",     "score_mean",          " (1-5)"),
    ]
    for label, key, suffix in metrics:
        on_v = on[key]
        off_v = off[key]
        if key == "success_rate":
            on_s = f"{on_v*100:.0f}%" if on_v is not None else "-"
            off_s = f"{off_v*100:.0f}%" if off_v is not None else "-"
            d = delta_pct(on_v, off_v)
        else:
            on_s = fmt(on_v, suffix)
            off_s = fmt(off_v, suffix)
            d = delta_pct(on_v, off_v)
        rows.append((label, on_s, off_s, d))

    widths = [max(len(r[i]) for r in rows) for i in range(4)]
    sep = "  ".join("─" * w for w in widths)
    lines.append("")
    for i, row in enumerate(rows):
        line = "  " + "  ".join(row[j].ljust(widths[j]) for j in range(4))
        lines.append(line)
        if i == 0:
            lines.append("  " + sep)

    # Flag if SME-on is meaningfully worse on both duration AND diff
    flags: list[str] = []
    if (on["duration_mean"] and off["duration_mean"]
        and (on["duration_mean"] - off["duration_mean"]) / off["duration_mean"] > 0.10):
        flags.append("duration > 10% slower on SME-on")
    if (on["success_rate"] is not None and off["success_rate"] is not None
        and on["success_rate"] < off["success_rate"] - 0.05):
        flags.append("success rate ≥ 5pt lower on SME-on")
    if flags:
        lines.append("")
        lines.append("  ⚠ Flags: " + "; ".join(flags))

    return "\n".join(lines)


def render_paired_section(rows: list[dict[str, Any]]) -> str:
    """Per-pair comparison: each pair_id has one off + one on row."""
    pairs: dict[str, dict[str, dict[str, Any]]] = defaultdict(dict)
    for r in rows:
        pid = r.get("pair_id")
        if not pid:
            continue
        pairs[pid][r.get("sme_mode", "?")] = r

    complete = {pid: m for pid, m in pairs.items() if "on" in m and "off" in m}
    if not complete:
        return "\n## paired-runs\n\n  (no complete pairs in ledger yet — use --paired on a run)"

    lines: list[str] = ["", f"## paired-runs ({len(complete)} pairs)", ""]
    on_faster = 0
    on_higher_score = 0
    for pid, m in complete.items():
        off, on = m["off"], m["on"]
        d_off = float(off.get("duration_seconds") or 0)
        d_on = float(on.get("duration_seconds") or 0)
        if d_on < d_off:
            on_faster += 1
        s_off = off.get("__score__")
        s_on = on.get("__score__")
        if s_on is not None and s_off is not None and s_on > s_off:
            on_higher_score += 1

    lines.append(f"  SME-on faster on duration:    {on_faster}/{len(complete)}")
    if on_higher_score > 0:
        lines.append(f"  SME-on higher review_score:   {on_higher_score}/{len(complete)} (where both scored)")
    return "\n".join(lines)


def render_classifier_audit(rows: list[dict[str, Any]]) -> str:
    """Show task_type_source breakdown — auto vs manual vs override."""
    by_source: dict[str, int] = defaultdict(int)
    overrides_by_target: dict[str, int] = defaultdict(int)
    for r in rows:
        src = r.get("task_type_source") or "(unset)"
        by_source[src] += 1
        if src == "manual-override":
            overrides_by_target[r.get("task_type", "?")] += 1

    lines: list[str] = ["", "## classifier audit", ""]
    total = sum(by_source.values())
    for src in sorted(by_source.keys()):
        pct = by_source[src] / total * 100 if total else 0
        lines.append(f"  {src:<20} {by_source[src]:>4}  ({pct:.0f}%)")

    if overrides_by_target:
        lines.append("")
        lines.append("  manual-overrides — what humans changed it to:")
        for tt in sorted(overrides_by_target.keys()):
            lines.append(f"    → {tt}: {overrides_by_target[tt]}")

    return "\n".join(lines)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--since", type=int, default=None, metavar="N",
                    help="restrict to runs in the last N days")
    ap.add_argument("--task-type", default=None, metavar="T",
                    help="restrict to a single task_type")
    ap.add_argument("--in", dest="in_path", type=Path,
                    default=Path.home() / ".claude-pipeline" / "ab-runs" / "runs.jsonl",
                    help="runs.jsonl path")
    ap.add_argument("--scores", dest="scores_path", type=Path,
                    default=Path.home() / ".claude-pipeline" / "ab-runs" / "scores.jsonl",
                    help="scores.jsonl path")
    ap.add_argument("--paired-only", action="store_true")
    ap.add_argument("--classifier-audit", action="store_true")
    args = ap.parse_args()

    rows = parse_runs(args.in_path, args.since, args.task_type)
    if not rows:
        print(f"no data at {args.in_path}"
              + (f" (filtered by task_type={args.task_type})" if args.task_type else "")
              + (f" (since={args.since}d)" if args.since else ""))
        return 0

    # Join scores by run_id (latest score wins)
    scores = load_latest_scores(args.scores_path)
    for r in rows:
        rid = r.get("run_id")
        r["__score__"] = scores.get(rid) if rid else None

    grouped: dict[tuple[str, str], list[dict[str, Any]]] = defaultdict(list)
    for r in rows:
        grouped[(r.get("task_type", "?"), r.get("sme_mode", "?"))].append(r)

    task_types = sorted({k[0] for k in grouped})

    print(f"# A/B report — {len(rows)} run(s)")
    print(f"  source: {args.in_path}")
    if args.scores_path.is_file():
        print(f"  scores: {args.scores_path} ({len(scores)} scored)")
    if args.since:
        print(f"  since: last {args.since} days")
    if args.task_type:
        print(f"  task_type: {args.task_type}")

    if not args.paired_only:
        for tt in task_types:
            on = aggregate(grouped.get((tt, "on"), []))
            off = aggregate(grouped.get((tt, "off"), []))
            print(render_task_section(tt, on, off))

    print(render_paired_section(rows))

    if args.classifier_audit:
        print(render_classifier_audit(rows))

    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
